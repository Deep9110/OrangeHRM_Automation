<?xml version="1.0" encoding="UTF-8"?>
<configuration status="WARN">
    <appenders>
        <!-- Console Appender - it will write logs in console-->
        <console name="Console" target="SYSTEM_OUT">
            <patternlayout pattern="%d{yyyy-MM-dd HH:mm:ss} [%t] %-5level %C{1} - %msg%n" />
        </console>

        <!-- General File Appender - create log file inside log folder -->
        <file name="FileLogger" filename="logs/app.log" append="true">
            <filters>
                <!-- Exclude ERROR and FATAL logs -->
                <thresholdfilter level="error" onMatch="DENY" onMismatch="ACCEPT" />
            </filters>
            <patternlayout pattern="%d{yyyy-MM-dd HH:mm:ss} [%t] %-5level %C{1} - %msg%n" />
        </file>

        <!-- Error File Appender - error.log will contain error and fatal related information  -->
        <file name="ErrorFileLogger" filename="logs/error.log" append="true">
            <filters>
        <!-- Include only ERROR and FATAL logs -->
                <thresholdfilter level="error" onMatch="ACCEPT" onMismatch="DENY" />
            </filters>
            <patternlayout pattern="%d{yyyy-MM-dd HH:mm:ss} [%t] %-5level %C{1} - %msg%n" />
        </file>
    </appenders>
    <loggers>
        <!-- Logger for com.demoproject (specify the package name here) -->
        <logger name="com.orangehrm" level="trace" additivity="false">
        <appenderref ref="Console" />
        <appenderref ref="FileLogger" />
        <appenderref ref="ErrorFileLogger" />
        </logger>
    </loggers>
</configuration>

